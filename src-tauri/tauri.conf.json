{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mux",
  "version": "0.2.5",
  "identifier": "com.mux.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cd src-tauri && cargo build --release --bin mux",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mux",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../scripts/permission-hook.cjs": "scripts/permission-hook.cjs"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AlexMartosP/mux-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2MTU4OUM1NDA1Nzk1OTYKUldTV2xWZEF4WWtWTnZTOGNwbW9vTFZicGQyZEkxRlYwQWxaK2dIYklhUXljdUVYSHF2dW93bmIK"
    }
  }
}
